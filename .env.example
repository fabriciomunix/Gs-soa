# Copie para .env (ou exporte no terminal) se quiser trocar o banco.
# SQLite (padrão, não precisa configurar nada):
DATABASE_URL=sqlite:///./alerta_corrego.db
# PostgreSQL (docker compose up -d):
# DATABASE_URL=postgresql+psycopg2://alerta:alerta@localhost:5432/alerta_corrego
CORS_ORIGINS=*
LOG_LEVEL=INFO
